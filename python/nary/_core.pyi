from collections.abc import Callable
from typing import Any, Literal, final, overload

@final
class Kind:
    def __call__(self, head: object) -> Expr: ...
    def __repr__(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def family(self) -> KindFamily | None: ...
    @property
    def params(self) -> tuple[Kind, ...]: ...
    @property
    def inputs(self) -> tuple[Kind, ...] | Any: ...
    @property
    def output(self) -> Kind | Any: ...
    @property
    def literals(self) -> tuple[type, ...]: ...

@final
class KindFamily:
    def __call__(self, *params: Kind) -> Kind: ...
    def __repr__(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def params(self) -> int | None: ...

@final
class Symbol:
    def __new__(cls, kind: Kind) -> Symbol: ...
    def __repr__(self) -> str: ...
    @property
    def kind(self) -> Kind: ...

@final
class Expr:
    def __call__(self, *args: object) -> Expr: ...
    def __getattr__(self, name: str) -> Any: ...
    def __repr__(self) -> str: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __lt__(self, other: object) -> Expr: ...
    def __le__(self, other: object) -> Expr: ...
    def __gt__(self, other: object) -> Expr: ...
    def __ge__(self, other: object) -> Expr: ...
    def __add__(self, other: object) -> Expr: ...
    def __radd__(self, other: object) -> Expr: ...
    def __sub__(self, other: object) -> Expr: ...
    def __rsub__(self, other: object) -> Expr: ...
    def __mul__(self, other: object) -> Expr: ...
    def __rmul__(self, other: object) -> Expr: ...
    def __truediv__(self, other: object) -> Expr: ...
    def __rtruediv__(self, other: object) -> Expr: ...
    def __pow__(self, other: object, modulo: None = None) -> Expr: ...
    def __rpow__(self, other: object, modulo: None = None) -> Expr: ...
    def __neg__(self) -> Expr: ...
    @property
    def kind(self) -> Kind: ...
    @property
    def head(self) -> Expr | Any: ...
    @property
    def args(self) -> tuple[Expr, ...]: ...
    @property
    def name(self) -> str | Any: ...
    @property
    def names(self) -> tuple[str, ...]: ...
    @property
    def params(self) -> tuple[Kind | Symbol, ...] | Any: ...
    @property
    def is_symbol(self) -> bool: ...
    @property
    def is_literal(self) -> bool: ...
    @property
    def is_constant(self) -> bool: ...
    @property
    def is_atom(self) -> bool: ...
    @property
    def value(self) -> Any: ...

Many: KindFamily

def declare_kind(name: str, literals: type | tuple[type, ...] | None = None) -> Kind: ...
def declare_kind_family(name: str, params: int | None = None) -> KindFamily: ...
def FunctionKind(inputs: tuple[Kind, ...], output: Kind) -> Kind: ...
def declare_function(
    name: str, *arg_kinds: Kind | Symbol, returns: Kind, names: tuple[str, ...] | None = None
) -> Expr: ...
def declare_constant(name: str, kind: Kind) -> Expr: ...
@overload
def set_operator(kind: Kind, symbol: Literal["neg"], function: Callable[[Expr], Expr]) -> None: ...
@overload
def set_operator(
    kind: Kind,
    symbol: Literal["+", "-", "*", "/", "**", "<", ">", "<=", ">="],
    function: Callable[[Expr, object], Expr],
) -> None: ...
