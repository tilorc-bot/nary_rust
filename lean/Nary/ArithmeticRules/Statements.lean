/-- `Rule(Mul(a, 1), a, name='mul_one')` -/
abbrev mul_one : Prop :=
  ∀ (a : Nary.Number), Nary.Mul [a, Nary.lit 1] = a

/-- `Rule(Mul(a, 0), 0, name='mul_zero')` -/
abbrev mul_zero : Prop :=
  ∀ (a : Nary.Number), a ≠ none → Nary.Mul [a, Nary.lit 0] = Nary.lit 0

/-- `Rule(Add(a, a), Mul(2, a), name='add_self')` -/
abbrev add_self : Prop :=
  ∀ (a : Nary.Number), Nary.Add [a, a] = Nary.Mul [Nary.lit 2, a]

/-- `Rule(Add(a, Mul(-1, a)), 0, name='sub_self')` -/
abbrev sub_self : Prop :=
  ∀ (a : Nary.Number), a ≠ none → Nary.Add [a, Nary.Mul [Nary.lit (-1), a]] = Nary.lit 0

/-- `Rule(Mul(a, Pow(a, -1)), 1, when=Ne(a, 0), name='div_self')` -/
abbrev div_self : Prop :=
  ∀ (a : Nary.Number), Nary.Holds (Nary.Ne a (Nary.lit 0)) → a ≠ none → Nary.Mul [a, Nary.Pow a (Nary.lit (-1))] = Nary.lit 1

/-- `Rule(Pow(a, 1), a, name='pow_one')` -/
abbrev pow_one : Prop :=
  ∀ (a : Nary.Number), Nary.Pow a (Nary.lit 1) = a

/-- `Rule(Pow(a, 0), 1, when=Ne(a, 0), name='pow_zero')` -/
abbrev pow_zero : Prop :=
  ∀ (a : Nary.Number), Nary.Holds (Nary.Ne a (Nary.lit 0)) → a ≠ none → Nary.Pow a (Nary.lit 0) = Nary.lit 1

/-- `Rule(exp(log(a)), a, when=Ne(a, 0), name='exp_log')` -/
abbrev exp_log : Prop :=
  ∀ (a : Nary.Number), Nary.Holds (Nary.Ne a (Nary.lit 0)) → Nary.exp (Nary.log a) = a

/-- `Rule(Add(m, n), computed(Add(m, n)), name='add_literals')` -/
abbrev add_literals : Prop :=
  ∀ (m n : ℤ), Nary.Add [Nary.lit m, Nary.lit n] = Nary.lit (m + n)

/-- `Rule(Mul(m, n), computed(Mul(m, n)), name='mul_literals')` -/
abbrev mul_literals : Prop :=
  ∀ (m n : ℤ), Nary.Mul [Nary.lit m, Nary.lit n] = Nary.lit (m * n)

/-- `Rule(Add(Mul(m, a), Mul(n, a)), Mul(computed(Add(m, n)), a), name='collect')` -/
abbrev collect : Prop :=
  ∀ (m n : ℤ) (a : Nary.Number), Nary.Add [Nary.Mul [Nary.lit m, a], Nary.Mul [Nary.lit n, a]] = Nary.Mul [Nary.lit (m + n), a]

/-- `Rule(Add(a, Mul(n, a)), Mul(computed(Add(n, 1)), a), name='collect_one')` -/
abbrev collect_one : Prop :=
  ∀ (n : ℤ) (a : Nary.Number), Nary.Add [a, Nary.Mul [Nary.lit n, a]] = Nary.Mul [Nary.lit (n + 1), a]

abbrev add_unordered : Prop :=
  Nary.Unordered Nary.Add

abbrev add_flat : Prop :=
  Nary.Flat Nary.Add

abbrev mul_unordered : Prop :=
  Nary.Unordered Nary.Mul

abbrev mul_flat : Prop :=
